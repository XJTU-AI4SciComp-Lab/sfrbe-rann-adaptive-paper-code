# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build files
build/
dist/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Logs
*.log

# Temporary files
tmp/
temp/

# Large generated outputs
results/*.npy
results/*.npz
results/*.mat
results/*.h5
results/*.hdf5
results/*.pkl

# Large data files
data/*.npy
data/*.npz
data/*.mat
data/*.h5
data/*.hdf5
data/*.pkl

# Small tracked reference data: explicit exceptions to the rules above
!data/darcy_phi.mat
!data/KdV62_reference_100x100.mat

# Generated outputs.  The results/*.mat style rules above only match files
# directly inside results/, while a run writes into results/<run_name>/;
# figures are exported to figures/<problem>/.  Use `git add -f` for the rare
# generated file that should be committed on purpose.
results/**
!results/README.md
figures/**
!figures/README.md
